{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "nickname": {
      "type": "string",
      "title": "Nickname"
    },
    "age_group": {
      "type": "string",
      "enum": [
        "13-17",
        "18-24",
        "25-34",
        "35-44",
        "45-54",
        "55+"
      ],
      "title": "Age Group"
    },
    "gender": {
      "type": "string",
      "title": "Gender"
    },
    "pronouns": {
      "type": "string",
      "enum": [
        "she/her",
        "he/him",
        "they/them",
        "ze/zir",
        "prefer not to say",
        "other"
      ],
      "title": "Pronouns"
    },
    "struggles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Struggles"
    },
    "onboarding_complete": {
      "type": "boolean",
      "title": "Onboarding Complete",
      "default": false
    },
    "subscribed": {
      "type": "boolean",
      "title": "Subscribed",
      "default": false
    }
  },
  "required": [
    "nickname"
  ]
}